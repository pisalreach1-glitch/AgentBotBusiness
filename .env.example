# Copy to .env and fill in values. Never commit the real .env.
TELEGRAM_TOKEN=
GEMINI_API_KEY=
# Official text model ID verified 2026-10-24. Change if your project requires another model.
# https://ai.google.dev/gemini-api/docs/models/gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
DATABASE_PATH=data/business.sqlite3
TIMEZONE=Asia/Phnom_Penh
DAILY_AI_REQUEST_LIMIT=30
AI_MAX_OUTPUT_TOKENS=5000
# Optional: comma-separated Telegram user IDs. Empty = all private users.
# You can get your ID with /id in the bot before enabling this restriction.
ALLOWED_USER_IDS=
